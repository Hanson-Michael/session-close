<?xml version="1.0" encoding="utf-8"?>
<!--
  Sparkle update feed for Session Close, tracked in the repo and served raw
  at https://raw.githubusercontent.com/Hanson-Michael/session-close/main/appcast.xml
  (see SUFeedURL in Info.plist / project.pbxproj build settings).

  No releases yet — see RELEASING.md for the one-time setup (Sparkle
  keypair, GitHub repo, notary profile) this project still needs before the
  first entry can be added here.

  To publish a new release:
  1. Bump MARKETING_VERSION (sparkle:shortVersionString) and
     CURRENT_PROJECT_VERSION (sparkle:version) in Xcode.
  2. Archive, export a Developer ID-signed + notarized build, zip the .app.
  3. Sign the zip: run `sign_update` (same Sparkle bin/ folder as
     generate_keys) against the zip — it prints the sparkle:edSignature and
     length values below.
  4. Upload the zip to a new GitHub Release.
  5. Add a new <item> below, newest first, pointing enclosure url at that
     release asset's download URL.
  6. Commit and push this file to main.
-->
<rss version="2.0" xmlns:sparkle="http://www.andymatuschak.org/xml-namespaces/sparkle" xmlns:dc="http://purl.org/dc/elements/1.1/">
    <channel>
        <title>Session Close</title>
        <link>https://raw.githubusercontent.com/Hanson-Michael/session-close/main/appcast.xml</link>
        <description>Update feed for Session Close.</description>
        <language>en</language>

    </channel>
</rss>
